theory RefreshNoSingleUse
begin

/*
  ★ NEG 版（必要性の実験）: 本体 refresh.spthy から、単回の使用済み化（P-RSINGLE）を外した変種。
    Fresh を persistent（!Fresh）にしたので、同じ RT から何度でもローテーションできる。
    期待: rt_single_use と reuse_stops_the_family が falsified。下の流れと性質の説明は本体のもの。

  refresh token（RT）のローテーションと、再利用の検出による系列の失効。

  流れ:
    1. AS は新しい系列 F と最初の RT を発行する
    2. RT を持つ者がそれを AS に出すと、AS は同じ系列の新しい RT を返す（ローテーション）。
       本体と違い、使用済みの印（!Used）は付けるが、元の RT は使えるまま残る（!Fresh）
    3. 使用済みの RT がもう一度出されたら（盗難の兆し）、AS は系列 F を丸ごと失効させる
       （失効した系列の RT は、どれを出しても受け付けない。受け付ける規則が無いことで表す）

  検証する性質:
    - rt_single_use: 1 つの RT から 2 回ローテーションは起きない
    - reuse_stops_the_family: ローテーション済みの RT がもう一度出されたら、その後その系列でローテーションは起きない
      （盗んだ側と正規の側のどちらが先に使っても、もう一方が古い RT を出した時点で系列が止まる）

  攻撃者: Dolev-Yao。盗難を最大に見るため、発行した RT はすべて攻撃者に見える（Out）。
          つまり性質は RT の秘匿に頼らず、AS の状態の遷移だけから出る。
  抽象: DPoP 束縛・クライアント認証・期限は外す（別のモデルと試験が見る）。
        系列の状態は Family(F, 'alive' | 'revoked') の linear な事実 1 つで表す。

  実行: tamarin-prover --prove --auto-sources formal/refresh_NEG_no_singleuse.spthy
*/

/* ---- 1. 新しい系列と最初の RT ---- */
rule AS_Issue:
    [ Fr(~F), Fr(~r) ]
  --[ Issue(~F, ~r) ]->
    [ Family(~F, 'alive'), !Fresh(~r, ~F), Out(~r) ]

/* ---- 2. ローテーション。NEG: Fresh を persistent にして P-RSINGLE（原子的な単回の使用済み化）を外した ---- */
rule AS_Rotate:
    [ In(r), !Fresh(r, F), Family(F, 'alive'), Fr(~n) ]
  --[ Present(F, r), Rotate(F, r, ~n) ]->
    [ !Used(r, F), !Fresh(~n, F), Family(F, 'alive'), Out(~n) ]

/* ---- 3. 使用済みの RT が出された。前提[P-RFAMILY]: 系列を丸ごと失効させる ---- */
rule AS_Reuse:
    [ In(r), !Used(r, F), Family(F, 'alive') ]
  --[ Present(F, r), Revoke(F) ]->
    [ Family(F, 'revoked') ]

/* ======================== 性質 ======================== */

lemma executable:
  exists-trace
    "Ex F r1 r2 r3 #i #j #k.
        Issue(F, r1) @ #i & Rotate(F, r1, r2) @ #j & Rotate(F, r2, r3) @ #k"

lemma rt_single_use:
    "All F r n1 n2 #i #j.
        Rotate(F, r, n1) @ #i & Rotate(F, r, n2) @ #j ==> #i = #j"

/* 失効した系列でローテーションは起きない（Family が linear で、'revoked' から 'alive' へ戻る規則が無い）。 */
lemma no_rotation_after_revoke [use_induction, reuse]:
    "All F m n #k #r. Rotate(F, m, n) @ #k & Revoke(F) @ #r ==> #k < #r"

lemma reuse_stops_the_family:
    "All F r n #i #j.
        Rotate(F, r, n) @ #i & Present(F, r) @ #j & #i < #j
      ==> not (Ex m n2 #k. Rotate(F, m, n2) @ #k & #j < #k)"

end
