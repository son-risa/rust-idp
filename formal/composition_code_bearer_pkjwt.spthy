theory CompositionCodeBearerPkjwt
begin

/*
  モデル #11b: 認可コード + PKCE + private_key_jwt + Bearer（本番の主な RP が移る先の形）
  token_endpoint_auth_method=private_key_jwt、require_pkce=true、require_par=false、dpop_bound=false。
  PAR も DPoP も無い。DCR の ConfidentialKey の profile（PAR と DPoP を必ず付ける）とは別の、
  client の旗を個別に決めた形。client_secret_basic の変種は composition_code_bearer_secret.spthy。
  2 つは client 認証の規則（登録・償還・token endpoint の検査・漏れ）だけが違う。

  #6（composition_code_dpop）との違い:
    - access token は Bearer。RS は token を持って来た者に応える（cnf.jkt の検査が無い）。
    - client 認証は client_assertion（iss=sub=C、aud=issuer、jti を 1 回だけ受ける）。AS は公開鍵だけを持つ。
      rust-idp の assertion は code や verifier に結び付かない（client_auth::PrivateKeyJwt）ので、モデルもそうする。
      exp の窓は記号モデルの外（Kani の exp_in_window_spec・jti_ttl_is_bounded が見る）。
    - token endpoint と RS の TLS を、AS の公開鍵への暗号化（サーバ認証の TLS）と、
      client が作る応答用の鍵 ~k で表す。#1 の「client の鍵への暗号化」より実際の TLS に近い。

  攻撃者: Dolev-Yao。フロントチャネル（authreq、code の redirect）は全部見えて、差し替えられる。
  認可コードは横取りできる（redirect の完全一致を外した最悪の場合として置く）。
  利用者は、フロントチャネルに来た client C 宛ての要求なら何にでも同意する（攻撃者が始めた要求にも）。

  漏れの規則（前提を表に出すために置く。lemma の条件に出てくる）:
    Reveal_ClientKey     client の保管庫から秘密鍵が漏れる        → P-CPRIVKEY
    Leak_TokenRequestLog token endpoint の要求の中身（client_assertion）が、
                         処理の後に記録から漏れる                → client_auth_sound の条件に入らない
    Leak_AT              client が持つ Bearer token が漏れる       → P-ATSTORE
    Reveal_User          利用者の passkey が漏れる                 → （#4 の前提）

  前提の ID と担保は formal/premises.json（model がこの file の行）と README のモデル #11。

  実行: tamarin-prover --prove --auto-sources formal/composition_code_bearer_pkjwt.spthy
*/

builtins: hashing, signing, asymmetric-encryption, symmetric-encryption

/* ---- AS（rust-idp）。TLS のサーバ鍵 ~tls と ID token の署名鍵 ~sk ----
   P-TLS: ~tls は漏れない。P-ENVSEP: ~sk は本番の版だけが持つ（漏れの規則は置かない）。 */
rule Setup_AS:
    [ Fr(~tls), Fr(~sk) ]
  --[ OnlyOnce('AS') ]->
    [ !ASTls(~tls), !ASTlsPub(pk(~tls)), !OPSig(~sk), !OPSigPub(pk(~sk))
    , Out(pk(~tls)), Out(pk(~sk)) ]

/* ---- 利用者と保護されたリソース（RS = /userinfo などの token で守る口）---- */
rule Setup_User:
    [ Fr(~uk), Fr(~res) ]
  --[ OnlyOnce(<'user', $U>), Protected($U, ~res) ]->
    [ !UserKey($U, ~uk), !UserPub($U, pk(~uk)), !Resource($U, ~res), Out(pk(~uk)) ]

rule Reveal_User:
    [ !UserKey(U, ~uk) ] --[ RevealUser(U) ]-> [ Out(~uk) ]

/* ---- client の登録。秘密鍵は client だけが持ち、AS は公開鍵（jwks）だけを持つ ---- */
rule Register_Client:
    [ Fr(~ck) ]
  --[ OnlyOnce(<'client', $C>) ]->
    [ !ClientKey($C, ~ck), !ClientPub($C, pk(~ck)), Out(pk(~ck)) ]

rule Reveal_ClientKey:
    [ !ClientKey(C, ~ck) ] --[ RevealClient(C) ]-> [ Out(~ck) ]

/* ---- client: 認可要求（PKCE S256 の challenge と nonce）。フロントチャネル ---- */
rule C_AuthReq:
    [ Fr(~v), Fr(~n), !ClientKey($C, ~ck) ]
  --[ ClientStart($C, ~v, ~n) ]->
    [ St_C1($C, ~v, ~n), Out(<'authreq', $C, h(~v), ~n>) ]

/* ---- 利用者: client C 宛ての要求に passkey で同意する（#4 の束縛）---- */
rule U_Consent:
    [ !UserKey(U, ~uk), In(<'authreq', C, ch, n>) ]
  --[ UserConsent(U, C, ch, n) ]->
    [ Out(<'consent', U, C, ch, n, sign(<'consent', U, C, ch, n>, ~uk)>) ]

/* ---- AS: 同意を確かめて認可コードを出す。code は (C, U, challenge, nonce) に結び付き、単回 ----
   redirect はフロントチャネルなので Out（横取りできる）。 */
rule AS_IssueCode:
    [ In(<'consent', U, C, ch, n, sig>), !UserPub(U, upk), Fr(~code) ]
  --[ Eq(verify(sig, <'consent', U, C, ch, n>, upk), true)
    , IssueCode(C, U, ~code, ch, n) ]->
    [ AS_Code(C, U, ~code, ch, n), Out(~code) ]

/* ---- client: code を token に換える。TLS の中で client_assertion（毎回新しい jti）と verifier を送る ---- */
rule C_Redeem:
    let ac = <'assert', C, 'iss', ~jti>
    in
    [ St_C1(C, ~v, ~n), !ClientKey(C, ~ck), !ASTlsPub(pkAS), In(code), Fr(~k), Fr(~jti) ]
  --[ ClientRedeem(C, code, ~v), ClientAssert(C, ~jti, code) ]->
    [ St_C2(C, ~v, ~n, ~k), Out(aenc(<'tokenreq', C, <ac, sign(ac, ~ck)>, code, ~v, ~k>, pkAS)) ]

/* ---- AS: token endpoint。code の単回消費 + client 認証（ハッシュの一致）+ PKCE ----
   Bearer: access token に鍵の束縛は無い。ID token は (iss, aud=C, sub=U, nonce, at_hash) に署名。 */
rule AS_IssueToken:
    let idc = <'idt', 'iss', C, U, n, h(~at)>
        idt = <idc, sign(idc, ~sk)>
        ac  = <'assert', C, 'iss', jti>
        cred = <ac, asig>
    in
    [ AS_Code(C, U, code, ch, n)
    , !ASTls(~tls), !ClientPub(C, cpk), !OPSig(~sk)
    , In(aenc(<'tokenreq', C, cred, code, v, k>, pk(~tls)))
    , Fr(~at)
    ]
  --[ Eq(verify(asig, ac, cpk), true)   // private_key_jwt（client_auth::PrivateKeyJwt、aud=issuer）
    , OnceJti(C, jti)                    // jti の単回（nonce::NonceStore::claim）
    , Eq(h(v), ch)                  // PKCE（auth_checks::CheckPkce）
    , ClientAuthed(C, code)
    , AuthedAssertion(C, jti, code)
    , IssueToken(C, U, code, ~at, idt)
    ]->
    [ !ATUser(~at, U), TokenReqLog(C, cred), Out(senc(<~at, idt>, k)) ]

/* ---- 漏れ: 処理を終えた token 要求の client 認証の値が記録から漏れる ---- */
rule Leak_TokenRequestLog:
    [ TokenReqLog(C, cred) ] --[ RevealLog(C) ]-> [ Out(cred) ]

/* ---- client: 応答を受け取り、ID token の署名・aud・nonce を確かめる ---- */
rule C_GetTokens:
    let idc = <'idt', 'iss', C, U, n, h(at)>
    in
    [ St_C2(C, v, n, k), !OPSigPub(opk), In(senc(<at, <idc, isig>>, k)) ]
  --[ Eq(verify(isig, idc, opk), true)
    , ClientAccept(C, v, n, U, at, <idc, isig>) ]->
    [ !ClientAT(C, U, at) ]

/* ---- 漏れ: client が持つ Bearer token が漏れる（記録、RP の不具合、端末への持ち出し）---- */
rule Leak_AT:
    [ !ClientAT(C, U, at) ] --[ RevealAT(at) ]-> [ Out(at) ]

/* ---- RS: Bearer。token を持って来た者に、その者の TLS の鍵でリソースを返す ---- */
rule C_UseAT:
    [ !ClientAT(C, U, at), !ASTlsPub(pkAS), Fr(~k2) ]
  --[ ClientUse(C, at) ]->
    [ Out(aenc(<'rsreq', at, ~k2>, pkAS)) ]

rule RS_Accept:
    [ !ATUser(at, U), !Resource(U, ~res), !ASTls(~tls), In(aenc(<'rsreq', at, k2>, pk(~tls))) ]
  --[ RS_Grant(at, U) ]->
    [ Out(senc(~res, k2)) ]

restriction Equality:
    "All x y #i. Eq(x, y) @ #i ==> x = y"
restriction OnceJti:
    "All c j #i #k. OnceJti(c, j) @ #i & OnceJti(c, j) @ #k ==> #i = #k"
restriction OnlyOnce:
    "All x #i #j. OnlyOnce(x) @ #i & OnlyOnce(x) @ #j ==> #i = #j"

/* ======================== 示す性質 ======================== */

lemma executable:
  exists-trace
    "Ex C v n U at idt code #a #b #g.
        ClientAccept(C, v, n, U, at, idt) @ #a
      & ClientRedeem(C, code, v) @ #b
      & RS_Grant(at, U) @ #g
      & not (Ex X #r. RevealClient(X) @ #r)
      & not (Ex X #r. RevealUser(X) @ #r)
      & not (Ex X #r. RevealAT(X) @ #r)
      & not (Ex X #r. RevealLog(X) @ #r)"

/* PKCE: 正直な client の要求から出た code を横取りしても、token は得られない。
   client の秘密が漏れていても成り立つ（条件に RevealClient が無い）。 */
lemma intercepted_code_unusable:
    "All C v n U code at idt #s #c #t.
        ClientStart(C, v, n) @ #s
      & IssueCode(C, U, code, h(v), n) @ #c
      & IssueToken(C, U, code, at, idt) @ #t
      ==> (not (Ex #k. K(at) @ #k)) | (Ex #r. RevealAT(at) @ #r)"

/* 秘匿: 正直な client が受け取った access token と ID token を、攻撃者は知らない。 */
lemma token_secrecy:
    "All C v n U at idt #a.
        ClientAccept(C, v, n, U, at, idt) @ #a
      ==> ((not (Ex #k. K(at) @ #k)) & (not (Ex #k. K(idt) @ #k)))
        | (Ex #r. RevealAT(at) @ #r)"

/* 注入への耐性: 正直な client がこの要求（v, n）で受け取った access token と ID token は、AS がこの client に、
   この要求の challenge h(v) と nonce n に結び付いた code に対して出したもの。別の要求の code（攻撃者が自分の
   要求で得た code を含む）、別の token、偽の ID token を混ぜられない。どの漏れの下でも成り立つ（条件が無い）。 */
lemma no_injection:
    "All C v n U at idt #a.
        ClientAccept(C, v, n, U, at, idt) @ #a
      ==> Ex code #c #t.
            IssueCode(C, U, code, h(v), n) @ #c
          & IssueToken(C, U, code, at, idt) @ #t
          & #c < #t & #t < #a"

/* 利用者との一致: その token の利用者 U は、まさにこの要求（C, h(v), n）に同意している。
   U の passkey が漏れた場合は除く（攻撃者が自分の口座で、見えた要求に同意する場合もここに入る）。 */
lemma consent_agreement:
    "All C v n U at idt #a.
        ClientAccept(C, v, n, U, at, idt) @ #a
      ==> (Ex #c. UserConsent(U, C, h(v), n) @ #c & #c < #a)
        | (Ex #r. RevealUser(U) @ #r)"

/* client のなりすまし: AS が C として認めた token 要求の assertion は、C 自身がこの code の償還のために作ったもの。
   秘密鍵が漏れない限り。処理を終えた要求の記録（assertion）が漏れても成り立つ（条件に RevealLog が無い）。
   jti の単回を外した NEG 版は、手元で 4 分を超えても反例の跡が出なかったので置いていない（README のモデル #11）。 */
lemma client_auth_sound:
    "All C jti code #i.
        AuthedAssertion(C, jti, code) @ #i
      ==> (Ex #r. ClientAssert(C, jti, code) @ #r & #r < #i)
        | (Ex #r. RevealClient(C) @ #r)"

/* 利用者のリソース: 利用者の passkey、client の秘密、Bearer token のどれも漏れなければ、漏れない。 */
lemma resource_secrecy:
    "All U res #p.
        Protected(U, res) @ #p
      & not (Ex #r. RevealUser(U) @ #r)
      & not (Ex X #r. RevealClient(X) @ #r)
      & not (Ex X #r. RevealAT(X) @ #r)
      ==> not (Ex #k. K(res) @ #k)"

/* ======================== 示せない性質（攻撃の跡が在ることを示す）========================
   exists-trace が verified = 攻撃の跡を Tamarin が見つけた = その性質は成り立たない。 */

/* Bearer: 漏れた access token は、client の秘密も passkey も無事なまま、そのまま使える。 */
lemma limit_bearer_theft_usable:
  exists-trace
    "Ex U res at #p #k #r.
        Protected(U, res) @ #p & K(res) @ #k & RevealAT(at) @ #r
      & not (Ex X #q. RevealClient(X) @ #q)
      & not (Ex X #q. RevealLog(X) @ #q)
      & not (Ex X #q. RevealUser(X) @ #q)"

/* 秘密鍵が漏れると、C になりすまして token endpoint を通れる。 */
lemma limit_key_leak_impersonation:
  exists-trace
    "Ex C code #i #r.
        ClientAuthed(C, code) @ #i & RevealClient(C) @ #r
      & not (Ex c2 v #q. ClientRedeem(C, c2, v) @ #q)"

/* 秘密鍵が漏れ、攻撃者が始めた要求に利用者が同意すると、利用者のリソースが漏れる。 */
lemma limit_key_leak_resource:
  exists-trace
    "Ex U res #p #k.
        Protected(U, res) @ #p & K(res) @ #k
      & not (Ex X #q. RevealUser(X) @ #q)
      & not (Ex X #q. RevealAT(X) @ #q)
      & not (Ex X #q. RevealLog(X) @ #q)"

end
