[
  {
    "id": "P-SINGLEUSE",
    "model": "oauth_code_pkce.spthy",
    "premise": "認可コードは原子的に単回消費される（AS_Code が linear）",
    "guard": ["src/store.rs: MemoryStore::take_code", "src/firestore_store.rs: FirestoreStore::take_code"],
    "tests": ["store::tests::code_reuse_revokes_issued_tokens", "grants::tests::auth_code_reuse_is_rejected", "firestore_store::tests::code_is_taken_once"]
  },
  {
    "id": "P-CODEFRESH",
    "model": "oauth_code_pkce.spthy",
    "premise": "認可コードは推測不能（CSPRNG = Fr）",
    "guard": ["src/web/oidc.rs: issue_code"],
    "outside": "乱数源（uuid v4 = OS の CSPRNG）の性質で、試験で示せる形をしていない"
  },
  {
    "id": "P-VERIFIER",
    "model": "oauth_code_pkce.spthy",
    "premise": "PKCE の verifier は秘密で、h(verifier)=challenge を AS が検査する",
    "guard": ["src/auth_checks.rs: CheckPkce::check", "src/auth_checks.rs: pkce_method_is_s256", "src/grants.rs: AuthorizationCodeGrant::handle"],
    "tests": ["auth_checks::tests::check_pkce_rules", "grants::tests::auth_code_pkce_success_and_failure"],
    "kani": ["pkce_method_no_downgrade"]
  },
  {
    "id": "P-CKEY",
    "model": "oauth_code_pkce.spthy",
    "premise": "クライアント秘密鍵は秘匿（漏れると token_secrecy が破れる）",
    "outside": "鍵はクライアントが持つ。rust-op は公開鍵だけを持つ"
  },
  {
    "id": "P-REG",
    "model": "oauth_code_pkce.spthy",
    "premise": "クライアントは事前登録され AS が公開鍵を知る",
    "guard": ["src/provider.rs: Provider::resolve_client"],
    "tests": ["auth_checks::tests::resolve_addressee_resolves_and_rejects_unknown_client", "client_auth::tests::secret_basic_unknown_client_rejected"]
  },
  {
    "id": "P-TLS",
    "model": "oauth_code_pkce.spthy",
    "premise": "トークン配送路は機密で正しいクライアントへ届く",
    "outside": "TLS は配備の基盤（Firebase Hosting / Cloud Run）が担う"
  },
  {
    "id": "P-DKEY",
    "model": "dpop_binding.spthy",
    "premise": "DPoP 秘密鍵は秘匿",
    "outside": "鍵はクライアントが持つ。rust-op は proof を検証するだけで鍵を持たない"
  },
  {
    "id": "P-CNF",
    "model": "dpop_binding.spthy",
    "premise": "RS は proof の鍵 thumbprint = token の cnf.jkt を検査する",
    "guard": ["src/web/mod.rs: authenticate_token"],
    "tests": ["web::token_auth_tests::bound_token_needs_a_proof_from_the_key_it_was_bound_to", "web::oidc::tests::introspection_dpop_token_includes_cnf_jkt"]
  },
  {
    "id": "P-PROOFSIG",
    "model": "dpop_binding.spthy",
    "premise": "DPoP proof の署名を検証する（ES256）",
    "guard": ["src/dpop.rs: Es256Dpop::verify"],
    "tests": ["dpop::tests::rejects_tampered_signature", "dpop::tests::rejects_proof_signed_by_different_key_than_embedded_jwk"]
  },
  {
    "id": "P-JTI",
    "model": "dpop_binding.spthy",
    "premise": "DPoP proof の jti は単回（リプレイ防止）",
    "guard": ["src/nonce.rs: NonceStore::claim"],
    "tests": ["dpop::tests::rejects_jti_replay", "nonce::tests::memory_claim_is_single_use", "nonce::tests::firestore_claim_is_single_use"]
  },
  {
    "id": "P-BIND",
    "model": "ciba_rar.spthy",
    "premise": "ユーザ承認は具体的 mandate に commit し、AS は承認された mandate のみ発行する",
    "guard": ["src/web/ciba.rs: ciba_approve", "src/grants.rs: CibaGrant::handle"],
    "tests": ["grants::tests::ciba_token_carries_the_mandate_stored_with_the_request", "web::ciba::tests::a_challenge_issued_for_another_request_cannot_approve_this_one"]
  },
  {
    "id": "P-UREAD",
    "model": "ciba_rar.spthy",
    "premise": "ユーザが binding_message を読む",
    "outside": "人間の前提。モデルの外"
  },
  {
    "id": "P-MSINGLE",
    "model": "ciba_rar.spthy",
    "premise": "マンデート（auth_req_id）は単回消費",
    "guard": ["src/ciba.rs: MemoryCibaStore::consume_if_approved", "src/ciba.rs: FirestoreCibaStore::consume_if_approved", "src/store.rs: MemoryStore::consume_mandate_if_unused"],
    "tests": ["ciba::tests::memory_store_consume_is_single_use", "store::tests::consume_mandate_is_single_use", "grants::tests::ciba_approved_issues_tokens_once_then_rejects_reuse", "ciba::tests::firestore_store_consume_is_single_use"]
  },
  {
    "id": "P-CAUTH",
    "model": "ciba_rar.spthy",
    "premise": "backchannel と poll でクライアント認証する",
    "guard": ["src/client_auth.rs: ClientSecretBasic::authenticate", "src/client_auth.rs: PrivateKeyJwt::authenticate"],
    "tests": ["client_auth::tests::secret_basic_wrong_secret_rejected", "client_auth::tests::pkjwt_rejects_iss_sub_mismatch_and_bad_signature", "grants::tests::ciba_unknown_and_other_client_rejected"]
  },
  {
    "id": "P-UAUTH",
    "model": "ciba_rar.spthy",
    "premise": "承認はユーザ認証（passkey）を経る",
    "guard": ["src/web/ciba.rs: ciba_approve"],
    "tests": ["web::ciba::tests::approval_needs_the_users_passkey"]
  },
  {
    "id": "P-AKEY",
    "model": "webauthn.spthy",
    "premise": "認証器の credential 鍵は秘匿",
    "outside": "鍵は認証器（secure enclave）が持つ。rust-op は公開鍵だけを持つ"
  },
  {
    "id": "P-ORIGIN",
    "model": "webauthn.spthy",
    "premise": "RP は origin/rpId == 自分 を検査する",
    "guard": ["src/fido/verify.rs: check_client_data", "src/fido/verify.rs: check_rp_id_hash"],
    "tests": ["fido::verify::tests::check_client_data_validates_all_fields", "fido::verify::tests::check_rp_id_hash_matches_and_mismatches", "webauthn::tests::registration_rejects_wrong_origin_and_challenge"]
  },
  {
    "id": "P-CHAL",
    "model": "webauthn.spthy",
    "premise": "challenge は新鮮で単回",
    "guard": ["src/registration.rs: create_webauthn_challenge", "src/registration.rs: consume_webauthn_challenge", "src/firestore.rs: Firestore::take_doc"],
    "tests": ["registration::tests::webauthn_challenge_is_consumed_once", "registration::tests::two_concurrent_consumes_of_one_webauthn_challenge_let_only_one_through"]
  },
  {
    "id": "P-SIG",
    "model": "webauthn.spthy",
    "premise": "登録した公開鍵で署名を検証する",
    "guard": ["src/webauthn.rs: verify_authentication"],
    "tests": ["webauthn::tests::authentication_rejects_signature_from_other_key", "fido::verify::tests::verify_assertion_accepts_valid_es256_and_rejects_tampered"]
  },
  {
    "id": "P-OPKEY",
    "model": "id_token.spthy",
    "premise": "OP の署名鍵は秘匿",
    "outside": "鍵は Cloud KMS に置き、プロセスに展開しない（配備の構成）"
  },
  {
    "id": "P-AUD",
    "model": "id_token.spthy",
    "premise": "RP は aud == 自分の client_id を検査する（OP は aud=client_id で発行する）",
    "guard": ["src/grants.rs: issue_access_and_id"],
    "tests": ["grants::tests::id_token_names_the_issuer_the_client_and_the_request_nonce"]
  },
  {
    "id": "P-NONCE",
    "model": "id_token.spthy",
    "premise": "nonce は新鮮で、OP は認可要求の nonce を token へ入れ、RP が一致を検査する",
    "guard": ["src/grants.rs: issue_access_and_id"],
    "tests": ["grants::tests::id_token_names_the_issuer_the_client_and_the_request_nonce"]
  },
  {
    "id": "P-SIG",
    "model": "id_token.spthy",
    "premise": "RP は OP の JWKS で署名を検証する",
    "guard": ["src/jws.rs: Es256Signer::sign"],
    "tests": ["jws::tests::sign_produces_verifiable_compact_jws", "jws::tests::tampered_payload_fails_verification", "jws::tests::kid_equals_jwk_thumbprint"]
  },
  {
    "id": "P-ISS",
    "model": "id_token.spthy",
    "premise": "iss（発行者）を確認する（IdP mix-up 防止）",
    "guard": ["src/grants.rs: issue_access_and_id"],
    "tests": ["grants::tests::id_token_names_the_issuer_the_client_and_the_request_nonce"]
  },
  {
    "id": "P-ICLIENT",
    "model": "invite.spthy",
    "premise": "招待を頼めるのは、招待を許した confidential client だけ（クライアント認証）",
    "guard": ["src/web/register.rs: authorize_invite_client"],
    "tests": ["web::register::invite_tests::clients_outside_the_allow_list_are_refused"]
  },
  {
    "id": "P-ITOKEN",
    "model": "invite.spthy",
    "premise": "token は推測不能（Fr）",
    "guard": ["src/registration.rs: random_token"],
    "outside": "乱数源（OsRng の 32 バイト）の性質で、試験で示せる形をしていない"
  },
  {
    "id": "P-ISINGLE",
    "model": "invite.spthy",
    "premise": "招待は原子的に単回消費される（Invite が linear）",
    "guard": ["src/registration.rs: consume_email_challenge", "src/firestore.rs: Firestore::take_doc"],
    "tests": ["registration::tests::invite_token_is_consumed_once", "registration::tests::two_concurrent_consumes_of_one_invite_let_only_one_through", "web::register::invite_tests::allowed_client_gets_link_that_registers_and_returns_to_rp"]
  },
  {
    "id": "P-IMAIL",
    "model": "invite.spthy",
    "premise": "リンクは E のメール箱の持ち主にだけ届く",
    "outside": "メールの配送は RP とメールの基盤が担う。漏れはモデルの Leak_Link で表す"
  }
]
